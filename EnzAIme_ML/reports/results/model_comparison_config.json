      "train_proteins": 19,
      "validation_proteins": 6
    },
    {
      "fold": 4,
      "train_records": 185,
      "validation_records": 36,
      "train_proteins": 19,
      "validation_proteins": 6
    },
    {
      "fold": 5,
      "train_records": 185,
      "validation_records": 36,
      "train_proteins": 19,
      "validation_proteins": 6
    }
  ],
  "preprocessing": "PCA and environmental StandardScaler are fit separately within each training fold."
}
