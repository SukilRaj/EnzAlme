# ENZAIme — example environment configuration
# Copy to .env and adjust as needed. All values here are optional; sensible
# defaults are defined in common/enzaime_core/config.py.

# --- ESM-2 / representation model (Section 8) ---
MODEL_NAME=facebook/esm2_t33_650M_UR50D
MODEL_NAME_FALLBACK=facebook/esm2_t6_8M_UR50D
DEVICE=auto
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_LENGTH=1024

# --- Recommendation engine ---
TOP_K=3
DEMO_MODE=true
WEIGHTS={"pollutant": 0.40, "ph": 0.25, "temperature": 0.25, "salinity": 0.10}
DELTA_PH=2.0
DELTA_TEMP=20.0
DELTA_SALINITY=1.5
SALINITY_UNKNOWN_SCORE=0.8

# --- Mutation module ---
MAX_MUTATIONS=500
TOP_CANDIDATE_POSITIONS=20
MUTATION_ALPHA=0.7

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Logging ---
LOG_LEVEL=INFO
